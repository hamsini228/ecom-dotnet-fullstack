@model List<YourCartVM>
@{
    ViewData["Title"] = "Your Cart!";
}

<div class="container py-5">

    @if (Model.Count > 0)
    {
        <div class="row">

            <!-- LEFT: CART ITEMS -->
            <div class="col-lg-8">

                <div class="card mb-4 border-0 shadow-sm">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Shopping Cart</h5>
                        <div>
                            <span class="text-muted">Total Items:</span>
                            <span class="fw-bold ms-1">@Model.Count</span>
                        </div>
                    </div>
                </div>

                @foreach (var item in Model)
                {
                    <div class="d-flex align-items-center border-bottom py-3">
                        <img src="~/@item.Picture"
                             style="width:100px;height:100px;object-fit:cover;"
                             class="rounded me-3" />

                        <div class="flex-grow-1">
                            <h6 class="mb-1">@item.ProductName</h6>
                            <small class="text-muted">@item.CategoryName</small><br />
                            <small>Size: @item.Size</small><br />
                            <div class="d-flex align-items-center gap-2 mt-2">

                                <!-- Decrease -->
                                <form asp-area="Carts" asp-controller="Home" asp-action="UpdateQuantity" method="post">
                                    <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                                    <input type="hidden" name="actionType" value="decrease" />
                                    <button class="btn btn-sm btn-outline-secondary">−</button>
                                </form>

                                <!-- Quantity -->
                                <span class="fw-bold">@item.Quantity</span>

                                <!-- Increase -->
                                <form asp-area="Carts" asp-controller="Home" asp-action="UpdateQuantity" method="post">
                                    <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                                    <input type="hidden" name="actionType" value="increase" />
                                    <button class="btn btn-sm btn-outline-secondary">+</button>
                                </form>

                            </div>
                        </div>

                        <div class="text-end">
                            <div class="fw-semibold text-dark">
                                ₹ @item.TotalPrice
                            </div>

                            <small class="text-muted text-decoration-line-through">
                                ₹ @(item.Price* item.Quantity)
                            </small>

                            @if (item.Discount > 0)
                            {
                                <div class="text-success small">
                                    @item.Discount% OFF
                                </div>
                            }
                            <form asp-area="Carts"
                                  asp-controller="Home"
                                  asp-action="RemoveFromCart"
                                  method="post"
                                  class="mt-2">

                                <input type="hidden" name="cartItemId" value="@item.CartItemId" />

                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    Remove
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>


            <!-- RIGHT: BILLING -->
            <div class="col-lg-4">

                @{
                    var totalAmount = (int)Math.Ceiling(Model.Sum(item => item.TotalPrice ));
                }

                <div class="card shadow-sm border-0 p-3 sticky-top" style="top: 100px;">

                    <h5 class="mb-3">Order Summary</h5>

                    <div class="d-flex justify-content-between mb-2">
                        <span>Items</span>
                        <span>@Model.Count</span>
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span>Total</span>
                        <span>₹ @totalAmount</span>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between fw-bold mb-3">
                        <span>Grand Total</span>
                        <span class="text-success">₹ @totalAmount</span>
                    </div>

                    <a asp-area="Payments" asp-controller="Home" asp-action="Index"
                       class="btn btn-dark w-100 py-2">
                        Proceed to Checkout
                    </a>
                    
                </div>

            </div>

        </div>

       
    }
    else
    {
        <div class="text-center py-5">
            <h4>Your Cart is Empty</h4>
            <a class="btn btn-success btn-sm" asp-area="Products" asp-controller="Home"
               asp-action="Index">Go To Products</a>
        </div>
    }

</div>
