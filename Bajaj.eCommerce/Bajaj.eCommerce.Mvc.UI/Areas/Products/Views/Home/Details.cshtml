@model ProductDetailsDTO

@{
    ViewData["Title"] = "Productsdetails";
}
<div class="container py-5">

    <div class="row g-5">

        <div class="col-md-6 d-flex gap-3">


            <div class="d-flex flex-column gap-2">
                <img src="~/@Model.Picture" class="thumb-img" onclick="changeImage(this)" />
                <img src="~/@Model.Picture" class="thumb-img" onclick="changeImage(this)" />
                <img src="~/@Model.Picture" class="thumb-img" onclick="changeImage(this)" />
            </div>


            <div class="flex-grow-1">
                <img id="mainImage"
                     src="~/@Model.Picture"
                     class="img-fluid rounded w-100 main-img" />
            </div>

        </div>


        <div class="col-md-6">

            <h2 class="fw-bold">@Model.ProductName</h2>


            <div class="mb-2">
                @{
                    var discounted = Model.UnitPrice - (Model.UnitPrice * Model.Discount / 100);
                }

                <span class="fs-4 fw-bold text-dark">₹ @discounted</span>

                @if (Model.Discount > 0)
                {
                    <span class="text-muted text-decoration-line-through ms-2">
                        ₹ @Model.UnitPrice
                    </span>

                    <span class="text-success ms-2">
                        @Model.Discount% OFF
                    </span>
                }
            </div>

            <p class="text-muted">@Model.Description</p>

            <p><strong>Type:</strong> @Model.ShoeType</p>
            <p><strong>Made In:</strong> @Model.MadeIn</p>

            <div class="d-flex align-items-center mb-3">

                <button class="btn btn-outline-secondary" onclick="decrease()">-</button>
                <input type="text" id="qty" value="1"
                       class="form-control text-center mx-2"
                       style="width:60px;" />
                <button class="btn btn-outline-secondary" onclick="increase()">+</button>

            </div>

            <a class="btn btn-dark w-100"
               asp-area="Carts"
               asp-controller="Home"
               asp-action="AddToCart"
               asp-route-productId="@Model.ProductId">
                Add to Cart
            </a>
            <hr />

            <p><strong>Warranty:</strong> @Model.WarrantyPeriod</p>
            <p><strong>Return Policy:</strong> @Model.ReturnPolicy</p>

        </div>

    </div>

</div>


