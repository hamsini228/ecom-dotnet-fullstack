@{
    ViewData["Title"] = "Payment Successful";
}

<div class="container py-5" style="max-width:640px; margin:auto;">

    <!-- Top Banner -->
    <div style="background: linear-gradient(135deg, #1a1a2e, #16213e);
                border-radius: 16px; padding: 40px 32px; text-align:center;
                color:#fff; margin-bottom: 24px;">

       

        <p style="font-size:10px;letter-spacing:4px;text-transform:uppercase;
                  color:#22c55e;margin-bottom:8px;">Payment Confirmed</p>
        <h2 class="fw-bold mb-2" style="font-size:28px;">Thank You!</h2>
        <p style="color:rgba(255,255,255,0.6);font-size:14px;margin:0;">
            Your payment was processed successfully.
        </p>
    </div>

    <!-- Order Details Card -->
    <div style="background:#fff;border:1px solid #e8e4df;border-radius:16px;
                padding:28px;margin-bottom:20px;">

        <div class="d-flex align-items-center gap-2 mb-4">
            <div style="width:36px;height:36px;background:#f0fdf4;border-radius:8px;
                        display:flex;align-items:center;justify-content:center;">
                <i class="bi bi-receipt" style="color:#22c55e;"></i>
            </div>
            <h6 class="fw-bold mb-0">Transaction Details</h6>
        </div>

        <div class="d-flex justify-content-between align-items-center py-3"
             style="border-bottom:1px dashed #e8e4df;">
            <span class="text-muted small">Status</span>
            <span style="background:#f0fdf4;color:#16a34a;font-size:11px;
                         font-weight:600;padding:4px 10px;border-radius:20px;">
                ✓ Paid
            </span>
        </div>

        <div class="d-flex justify-content-between align-items-center py-3"
             style="border-bottom:1px dashed #e8e4df;">
            <span class="text-muted small">Payment ID</span>
            <span class="fw-semibold" style="font-size:11px;font-family:monospace;
                                              color:#1a1a2e;">
                @ViewBag.PaymentId
            </span>
        </div>

        <div class="d-flex justify-content-between align-items-center py-3">
            <span class="text-muted small">Order ID</span>
            <span class="fw-semibold" style="font-size:11px;font-family:monospace;
                                              color:#1a1a2e;">
                @ViewBag.OrderId
            </span>
        </div>
    </div>

    <div style="background:#fffbeb;border:1px solid #fde68a;border-radius:10px;
                padding:14px 18px;margin-bottom:24px;display:flex;gap:10px;align-items:flex-start;">
        <i class="bi bi-info-circle" style="color:#d97706;margin-top:2px;"></i>
        <p style="font-size:12px;color:#92400e;margin:0;line-height:1.6;">
            Your order is confirmed. Please generate your invoice below and keep it for your records.
        </p>
    </div>

    <div class="d-flex gap-3">
        <a href="/Invoices/Home/Create?paymentId=@ViewBag.PaymentId&orderId=@ViewBag.OrderId&cartId=@ViewBag.CartId"
           class="btn btn-dark flex-grow-1 py-3 fw-semibold"
           style="border-radius:10px;letter-spacing:0.5px;">
            <i class="bi bi-file-earmark-text me-2"></i> Generate Invoice
        </a>
        <a asp-area="Products" asp-controller="Home" asp-action="Index"
           class="btn btn-outline-secondary py-3"
           style="border-radius:10px;padding-inline:20px;">
            <i class="bi bi-shop"></i> Go Shopping
        </a>
    </div>

</div>