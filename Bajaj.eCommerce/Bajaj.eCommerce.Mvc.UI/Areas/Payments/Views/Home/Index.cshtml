@model IEnumerable<YourCartVM>
@{
    ViewData["Title"] = "Payment";
    var discountedTotal = Model.Sum(x => x.TotalPrice);
    var originalTotal = Model.Sum(x => x.Price * x.Quantity);
    var savings = originalTotal - discountedTotal;
}

<div class="container py-5">
    <div class="mb-4">
        <h2 class="fw-bold mb-0">Complete Payment</h2>
    </div>

    <div class="row g-4">

        <!-- LEFT: ORDER ITEMS -->
        <div class="col-lg-7">
            <div style="background:#fff;border:1px solid #e8e4df;border-radius:10px;padding:24px;">
                <h6 class="fw-bold mb-3">Order Items</h6>
                @foreach (var item in Model)
                {
                    var original = item.Price * item.Quantity;
                    <div class="d-flex align-items-center gap-3 mb-3 pb-3"
                         style="border-bottom:1px solid #f0ece7;">
                        <img src="~/@item.Picture"
                             style="width:80px;height:80px;object-fit:cover;border-radius:8px;" />
                        <div class="flex-grow-1">
                            <h6 class="fw-bold mb-0">@item.ProductName</h6>
                            <small class="text-muted">@item.CategoryName</small>
                            @if (item.Discount > 0)
                            {
                                <div>
                                    <span class="badge"
                                          style="color:#fff;font-size:10px;">
                                        @item.Discount% OFF
                                    </span>
                                </div>
                            }
                        </div>
                        <div class="text-end">
                            @if (item.Discount > 0)
                            {
                                <div class="text-muted small text-decoration-line-through">
                                    ₹ @original.ToString("0.##")
                                </div>
                            }
                            <div class="fw-bold" ">
                                ₹ @item.TotalPrice.ToString("0.##")
                            </div>
                            <small class="text-muted">Qty: @item.Quantity</small>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- RIGHT: PAYMENT SUMMARY -->
        <div class="col-lg-5">
            <div style="background:#fff;border:1px solid #e8e4df;border-radius:10px;padding:24px;">
                <h5 class="fw-bold mb-3">Payment Summary</h5>
                <hr />

                <div class="d-flex justify-content-between mb-2 text-muted small">
                    <span>Total Items</span>
                    <span>@Model.Sum(x => x.Quantity)</span>
                </div>
                <div class="d-flex justify-content-between mb-2 text-muted small">
                    <span>Original Price</span>
                    <span>₹ @originalTotal.ToString("0.##")</span>
                </div>
                @if (savings > 0)
                {
                    <div class="d-flex justify-content-between mb-2 small">
                        <span style="color:#22c55e;">Discount Savings</span>
                        <span style="color:#22c55e;">− ₹ @savings.ToString("0.##")</span>
                    </div>
                }
                <div class="d-flex justify-content-between mb-2 text-muted small">
                    <span>Shipping</span>
                    <span style="color:#22c55e;">Free</span>
                </div>

                <hr />

                <div class="d-flex justify-content-between mb-4">
                    <span class="fw-bold">Total Payable</span>
                    <span class="fw-bold" style="font-size:20px;">
                        ₹ @discountedTotal.ToString("0.##")
                    </span>
                </div>

                @if (savings > 0)
                {
                    <div class="text-center mb-3 p-2"
                         style="background:#f0fdf4;border-radius:6px;color:#16a34a;font-size:12px;font-weight:600;">
                        You save ₹ @savings.ToString("0.##") on this order!
                    </div>
                }

                @Html.AntiForgeryToken()

                <button id="rzp-btn" class="btn btn-dark w-100 py-3 fw-semibold">
                    💳 Pay ₹ @discountedTotal.ToString("0.##")
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <script>
        document.getElementById('rzp-btn').addEventListener('click', async function () {
            const btn = this;
            btn.disabled = true;
            btn.innerHTML = '⏳ Creating Order...';

            try {
                const res = await fetch('@Url.Action("CreateRazorpayOrder", "Home", new { area = "Payments" })', {
                    method: 'POST'
                });

                if (!res.ok) {
                    alert('Failed to create order. Please try again.');
                    btn.disabled = false;
                    btn.innerHTML = '💳 Pay ₹ @discountedTotal.ToString("0.##")';
                    return;
                }

                const data = await res.json();

                const options = {
                    key: data.key,
                    amount: data.amount,
                    currency: data.currency,
                    order_id: data.orderId,
                    name: 'Your Store',
                    description: 'Order Payment',
                    theme: { color: '#212529' },
                    handler: function (response) {
                        window.location.href = '/Payments/Home/Success'
                            + '?paymentId=' + response.razorpay_payment_id
                            + '&orderId=' + response.razorpay_order_id;
                    },
                    modal: {
                        ondismiss: function () {
                            btn.disabled = false;
                            btn.innerHTML = '💳 Pay ₹ @discountedTotal.ToString("0.##")';
                        }
                    }
                };

                const rzp = new Razorpay(options);
                rzp.open();

            } catch (err) {
                console.error(err);
                btn.disabled = false;
                btn.innerHTML = '💳 Pay ₹ @discountedTotal.ToString("0.##")';
            }
        });
    </script>
}